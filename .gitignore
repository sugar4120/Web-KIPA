# WordPress Docker .gitignore

# Environment & Credentials
.env

# WordPress Uploads & Runtime Data
wp-content/uploads/*
!wp-content/uploads/.gitkeep
wp-content/upgrade/*
wp-content/cache/*
wp-content/backup-db/*
wp-content/debug.log

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.log
