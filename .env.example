# ==========================================
# CẤU HÌNH DỰ ÁN WORDPRESS KIPA (MẪU)
# ==========================================

# Cổng truy cập Web WordPress
WORDPRESS_PORT=8080
WORDPRESS_TABLE_PREFIX=wp_

# Cấu hình Cơ sở dữ liệu MySQL
MYSQL_DATABASE=kipa_db
MYSQL_USER=kipa_user
MYSQL_PASSWORD=kipa_secret_password
MYSQL_ROOT_PASSWORD=kipa_root_password
MYSQL_PORT=3306

# Cổng truy cập phpMyAdmin
PHPMYADMIN_PORT=8081
